    <Folder><name>Support car logistics - provisional</name>
      <description>Support-car markers only. A continuous car route is intentionally omitted until the organizer confirms safe trail-access, Coast Highway rendezvous, and the exit 54C Chevron pins.</description>

    <Placemark>
      <name>LA River Trail support access</name>
      <description>Provisional support-car logistics point. During river trail, drive ahead and meet runners where trail meets road: LA River Trail. Send replacement runner onto trail and collect outgoing runner: LA River Trail.</description>
      <styleUrl>#carMarker</styleUrl>
      <Point><coordinates>-118.1982717,33.858386,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Coast Highway car rendezvous</name>
